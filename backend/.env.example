# PostgreSQL connection string from your managed provider (Neon, Supabase, Render Postgres...)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/spendwise
# Comma-separated list of frontend origins allowed to call this API (no trailing slash)
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app
# Optional: enables the AI monthly summary. Leave blank to keep that feature off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
